# Copy to ".env.local" and fill in values (never commit .env.local).
# Format: KEY=value — no spaces around =, no quotes unless the value has spaces,
# no trailing commas, no backticks.
# Firebase: Firebase Console → Project settings → Your apps (Web).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# EmailJS: dashboard → Account / Email Services / Email Templates.
# Use the same public key for init and send (one key per EmailJS account).
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# Optional fallback tuple (used only if primary EmailJS config fails, e.g. during migration)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY_FALLBACK=
NEXT_PUBLIC_EMAILJS_SERVICE_ID_FALLBACK=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_FALLBACK=

# Public contact email (optional in CI; add to GitHub secrets if you display it from env)
NEXT_PUBLIC_BUSINESS_EMAIL=
